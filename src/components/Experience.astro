---
import StickyHeader from './Sticky-header.astro';
import ExperienceCard from './Experience-card.astro';

interface Experience {
  title: string;
  link?: string;
  description: string;
  company: string;
  dates: string;
  tech?: Array<string>;
}

const experience: Experience[] = [
  {
    title: 'Web Development Consultant',
    company: 'Contractor',
    description: 'Collaborating with brands to build amazing user experiences',
    dates: '2024 - Present',
    tech: ['Headless Shopify', 'Shopify', 'Webflow', 'Hubspot', 'Wordpress'],
  },
  {
    title: 'Frontend E-commerce Developer ·',
    company: 'Legends Global Merchandise',
    description: "Rebuild entire sites for the world's biggest sports brands",
    dates: '2023 - 2024',
    tech: [
      'Javascript',
      'Reactjs',
      'Headless Shopify',
      'Nextjs',
      'Shopify',
      'Webflow',
      'Hubspot',
    ],
  },
  {
    title: 'Frontend Developer ·',
    company: 'Drinks',
    description:
      'Client website optimization · SEO optimization · Accessibility Audits · Built subscription portals ',
    dates: '2021 - 2023',
    tech: [
      'AlpineJS',
      'Vuejs',
      'Tailwind',
      'Shopify',
      'Hubspot',
      'Wordpress',
      'GraphQL',
    ],
  },
  {
    title: 'Fullstack Engineer ·',
    company: 'Urban TXT',
    description:
      'Added new features to in house CRM · Built Slack bots for internal processes · Developed Mobile App to teach teenagers how to save and invest',
    dates: '2020 - 2021',
    tech: ['Angular', 'Express', 'MongoDB', 'TypeScript', 'Ionic', 'Bootstrap'],
  },
];

const resumeUrl =
  'https://drive.google.com/file/d/15xWux3eJ0TctD3qLbWIPgzkrnCXenRhK/view';
---

<section id='EXPERIENCE'>
  <StickyHeader title='EXPERIENCE' />
  <div>
    {
      experience.map((e) => (
        <ExperienceCard
          dates={e.dates}
          title={e.title}
          description={e.description}
          company={e.company}
          tech={e.tech}
        />
      ))
    }
  </div>
</section>
